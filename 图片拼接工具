<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>图片拼接工具</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #f5f5f7; color: #1d1d1f; line-height: 1.5;
    display: flex; flex-direction: column; min-height: 100vh;
  }
  header {
    background: #fff; border-bottom: 1px solid #e5e5ea;
    padding: 12px 20px; display: flex; align-items: center; justify-content: space-between;
    flex-shrink: 0;
  }
  header h1 { font-size: 16px; font-weight: 600; }
  header .badge {
    font-size: 11px; background: #e8f4fd; color: #0071e3;
    padding: 3px 10px; border-radius: 20px;
  }
  .app { display: flex; flex: 1; overflow: hidden; }
  
  /* 侧边栏 */
  .sidebar {
    width: 340px; background: #fff; border-right: 1px solid #e5e5ea;
    overflow-y: auto; padding: 20px; flex-shrink: 0;
  }
  
  /* 主预览区 */
  .main {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center; padding: 24px; overflow: auto;
    background-color: #e5e5ea;
  }
  
  .group { margin-bottom: 22px; }
  .group-title {
    font-size: 11px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.5px; color: #86868b; margin-bottom: 10px;
  }
  .btn {
    display: block; width: 100%; padding: 10px 14px; border: none; border-radius: 8px;
    font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.15s; text-align: center;
  }
  .btn-primary { background: #0071e3; color: #fff; }
  .btn-primary:hover { background: #0077ed; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  
  /* 参数行 */
  .row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .row label { font-size: 13px; color: #1d1d1f; }
  
  /* 自定义数字输入框 */
  .num-input {
    width: 65px; padding: 4px 8px; border: 1px solid #d2d2d7; border-radius: 6px;
    text-align: right; font-size: 13px; color: #0071e3; font-weight: 600; outline: none;
    transition: border-color 0.2s;
  }
  .num-input:focus { border-color: #0071e3; }
  .num-input::-webkit-outer-spin-button, .num-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  
  input[type="range"] { width: 100%; accent-color: #0071e3; margin-bottom: 10px; }
  select, input[type="color"] {
    width: 100%; padding: 7px 10px; border: 1px solid #d2d2d7; border-radius: 6px;
    font-size: 13px; background: #fff;
  }
  input[type="color"] { height: 36px; padding: 2px; cursor: pointer; margin-bottom: 10px; }
  
  /* 图片列表带缩略图 */
  .file-list { margin-top: 8px; max-height: 220px; overflow-y: auto; }
  .file-item {
    display: flex; align-items: center; gap: 10px; padding: 6px; margin-bottom: 6px;
    border-radius: 8px; font-size: 12px; cursor: grab; user-select: none; 
    border: 1px solid #e5e5ea; background: #fafafa;
  }
  .file-item:hover { background: #f5f5f7; border-color: #d2d2d7; }
  .file-item .idx {
    width: 20px; height: 20px; border-radius: 50%; background: #e5e5ea;
    display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; flex-shrink: 0;
  }
  /* 缩略图样式 */
  .file-item .thumb {
    width: 36px; height: 36px; object-fit: cover; border-radius: 4px;
    flex-shrink: 0; background: #fff; border: 1px solid #e5e5ea;
  }
  .file-item .name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #1d1d1f; }
  .file-item .remove {
    width: 24px; height: 24px; border: none; background: transparent;
    color: #86868b; cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center;
  }
  .file-item .remove:hover { background: #ffe5e5; color: #ff3b30; border-radius: 50%; }
  
  .checkbox-row {
    display: flex; align-items: center; gap: 8px; font-size: 13px; cursor: pointer;
    padding: 10px; background: #f0f7ff; border-radius: 8px; border: 1px solid #cce4ff; margin-bottom: 8px;
  }
  .checkbox-row input { width: 18px; height: 18px; accent-color: #0071e3; cursor: pointer; }
  
  /* 预览画布容器 */
  .canvas-wrap {
    background: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    padding: 10px; max-width: 100%; max-height: 100%; overflow: auto; display: flex; align-items: center; justify-content: center;
    /* 棋盘格背景 */
    background-image: linear-gradient(45deg, #eee 25%, transparent 25%), linear-gradient(-45deg, #eee 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #eee 75%), linear-gradient(-45deg, transparent 75%, #eee 75%);
    background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
  }
  #previewCanvas { display: block; max-width: 100%; height: auto; }
  .empty-state { text-align: center; color: #86868b; font-size: 14px; padding: 60px 20px; }
  
  .hint { font-size: 11px; color: #86868b; margin-top: 4px; line-height: 1.4; }
  .divider { height: 1px; background: #e5e5ea; margin: 16px 0; }
  .crop-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  .toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    background: #1d1d1f; color: #fff; padding: 10px 20px; border-radius: 8px;
    font-size: 13px; opacity: 0; transition: opacity 0.3s; pointer-events: none; z-index: 100;
  }
  .toast.show { opacity: 1; }

  /* 📱 手机端响应式优化：预览区在上，侧边栏在下 */
  @media (max-width: 768px) {
    .app { flex-direction: column; }
    .main { order: -1; height: 45vh; padding: 10px; flex: none; background-color: #f5f5f7; }
    .sidebar { width: 100%; height: 55vh; border-right: none; border-top: 1px solid #e5e5ea; padding: 16px; }
  }
</style>
</head>
<body>

<header>
  <h1>🖼️ 图片拼接工具</h1>
  <span class="badge">精准去边 · 本地处理</span>
</header>

<div class="app">
  <!-- 预览区 (在手机上会显示在顶部) -->
  <main class="main">
    <div class="canvas-wrap" id="canvasWrap">
      <div class="empty-state" id="emptyState">
        <div style="font-size:48px; margin-bottom:12px;">📂</div>
        <div>添加图片后自动生成预览</div>
      </div>
      <canvas id="previewCanvas" style="display:none;"></canvas>
    </div>
  </main>

  <!-- 侧边栏 -->
  <aside class="sidebar">
    <div class="group">
      <div class="group-title">图片</div>
      <button class="btn btn-primary" id="uploadBtn">选择图片（可多选）</button>
      <input type="file" id="fileInput" accept="image/*" multiple hidden>
      <div class="file-list" id="fileList"></div>
    </div>

    <div class="group">
      <div class="group-title">布局</div>
      <select id="layoutSelect" style="margin-bottom:10px;">
        <option value="horizontal">水平拼接</option>
        <option value="vertical">垂直拼接</option>
        <option value="grid">网格拼接</option>
      </select>
      <div id="gridColsGroup" style="display:none;">
        <div class="row"><label>网格列数</label><input type="number" id="gridColsInput" class="num-input" min="1" max="6" value="2"></div>
        <input type="range" id="gridColsRange" min="1" max="6" value="2" step="1">
      </div>
      
      <!-- 图片间距 支持直接输入 -->
      <div class="row">
        <label>图片间距</label>
        <input type="number" id="gapInput" class="num-input" min="0" max="100" value="0"> 
      </div>
      <input type="range" id="gapRange" min="0" max="100" value="0" step="1">
      
      <div class="row"><label>背景颜色</label></div>
      <input type="color" id="bgColor" value="#ffffff">
    </div>

    <div class="divider"></div>

    <div class="group">
      <div class="group-title" style="color:#0071e3;">精准裁剪 (去白边/去黑边)</div>
      <div class="hint" style="margin-bottom:8px;">如果四周有多余白边，可以直接在框内输入数字切除像素，或滑动调节。</div>
      
      <div class="crop-grid">
        <div>
          <div class="row">
            <label>上边距</label>
            <input type="number" id="cropTopInput" class="num-input" min="0" max="1000" value="0">
          </div>
          <input type="range" id="cropTop" min="0" max="1000" value="0" step="1">
        </div>
        <div>
          <div class="row">
            <label>下边距</label>
            <input type="number" id="cropBottomInput" class="num-input" min="0" max="1000" value="0">
          </div>
          <input type="range" id="cropBottom" min="0" max="1000" value="0" step="1">
        </div>
        <div>
          <div class="row">
            <label>左边距</label>
            <input type="number" id="cropLeftInput" class="num-input" min="0" max="1000" value="0">
          </div>
          <input type="range" id="cropLeft" min="0" max="1000" value="0" step="1">
        </div>
        <div>
          <div class="row">
            <label>右边距</label>
            <input type="number" id="cropRightInput" class="num-input" min="0" max="1000" value="0">
          </div>
          <input type="range" id="cropRight" min="0" max="1000" value="0" step="1">
        </div>
      </div>
      
      <label class="checkbox-row" style="margin-top:16px;">
        <input type="checkbox" id="autoTrimCb">
        <span>开启自动去纯色边(可能误伤)</span>
      </label>
    </div>

    <div class="group" style="margin-bottom: 40px;">
      <div class="group-title">导出</div>
      <button class="btn btn-primary" id="downloadBtn" disabled>下载 PNG</button>
    </div>
  </aside>
</div>

<div class="toast" id="toast"></div>

<script>
(function () {
  'use strict';

  // DOM 元素引用
  const uploadBtn = document.getElementById('uploadBtn');
  const fileInput = document.getElementById('fileInput');
  const fileListEl = document.getElementById('fileList');
  const layoutSelect = document.getElementById('layoutSelect');
  const gridColsGroup = document.getElementById('gridColsGroup');
  
  // 间距
  const gapRange = document.getElementById('gapRange');
  const gapInput = document.getElementById('gapInput');
  
  // 网格列数
  const gridColsRange = document.getElementById('gridColsRange');
  const gridColsInput = document.getElementById('gridColsInput');
  
  // 颜色
  const bgColorInput = document.getElementById('bgColor');
  
  // 裁剪控制
  const cropTop = document.getElementById('cropTop');
  const cropBottom = document.getElementById('cropBottom');
  const cropLeft = document.getElementById('cropLeft');
  const cropRight = document.getElementById('cropRight');
  const cropTopInput = document.getElementById('cropTopInput');
  const cropBottomInput = document.getElementById('cropBottomInput');
  const cropLeftInput = document.getElementById('cropLeftInput');
  const cropRightInput = document.getElementById('cropRightInput');
  const autoTrimCb = document.getElementById('autoTrimCb');

  const downloadBtn = document.getElementById('downloadBtn');
  const previewCanvas = document.getElementById('previewCanvas');
  const emptyState = document.getElementById('emptyState');
  const toastEl = document.getElementById('toast');
  const ctx = previewCanvas.getContext('2d');

  let items = []; 
  let renderToken = 0;
  let dragSrcId = null;

  function toast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => toastEl.classList.remove('show'), 1800);
  }

  function uid() { return Math.random().toString(36).slice(2, 10); }

  function loadImage(file) {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('图片加载失败')); };
      img.src = url;
    });
  }

  // 生成缩略图用于列表展示
  function createThumbnail(img) {
    const canvas = document.createElement('canvas');
    const size = 80; // 生成大一点的缩略图，保证清晰度
    canvas.width = size; canvas.height = size;
    const ctx = canvas.getContext('2d');
    // 居中裁剪
    const scale = Math.max(size / img.width, size / img.height);
    const w = img.width * scale;
    const h = img.height * scale;
    const x = (size - w) / 2;
    const y = (size - h) / 2;
    ctx.drawImage(img, x, y, w, h);
    return canvas.toDataURL('image/jpeg', 0.85);
  }

  // 双向绑定 Range 和 Number 输入框的工具函数
  function bindInputs(rangeEl, numEl, callback) {
    // 拖动滑动条 -> 更新输入框
    rangeEl.addEventListener('input', () => {
      numEl.value = rangeEl.value;
      callback();
    });
    // 输入数字 -> 更新滑动条
    numEl.addEventListener('input', () => {
      let val = parseInt(numEl.value);
      if (isNaN(val)) return; // 允许清空时暂时不处理
      
      const min = parseInt(rangeEl.min);
      const max = parseInt(rangeEl.max);
      if (val < min) val = min;
      if (val > max) val = max;
      
      rangeEl.value = val;
      callback();
    });
    // 输入框失去焦点时，如果为空或越界，纠正显示
    numEl.addEventListener('blur', () => {
      let val = parseInt(numEl.value);
      if (isNaN(val)) val = parseInt(rangeEl.min);
      const min = parseInt(rangeEl.min);
      const max = parseInt(rangeEl.max);
      if (val < min) val = min;
      if (val > max) val = max;
      numEl.value = val;
      rangeEl.value = val;
      callback();
    });
  }

  // 核心处理：裁切图片
  function processImage(img, autoTrim, cTop, cBottom, cLeft, cRight) {
    const w = img.naturalWidth || img.width;
    const h = img.naturalHeight || img.height;
    let top = 0, bottom = h - 1, left = 0, right = w - 1;

    if (autoTrim) {
      const off = document.createElement('canvas');
      off.width = w; off.height = h;
      const octx = off.getContext('2d', { willReadFrequently: true });
      octx.drawImage(img, 0, 0, w, h);
      
      try {
        const data = octx.getImageData(0, 0, w, h).data;
        let refR = data[0], refG = data[1], refB = data[2]; // 左上角像素基准

        const isBg = (x, y) => {
          const i = (y * w + x) * 4;
          if (data[i+3] < 10) return true; 
          return Math.max(Math.abs(data[i] - refR), Math.abs(data[i+1] - refG), Math.abs(data[i+2] - refB)) <= 30;
        };

        // 扫描上下左右 (允许5%的杂色容差，防止被状态栏文字卡住)
        for (let y = 0; y < h; y++) {
          let bgCount = 0;
          for (let x = 0; x < w; x++) { if (isBg(x, y)) bgCount++; }
          if (bgCount < w * 0.95) { top = y; break; }
        }
        for (let y = h - 1; y >= top; y--) {
          let bgCount = 0;
          for (let x = 0; x < w; x++) { if (isBg(x, y)) bgCount++; }
          if (bgCount < w * 0.95) { bottom = y; break; }
        }
        for (let x = 0; x < w; x++) {
          let bgCount = 0;
          for (let y = top; y <= bottom; y++) { if (isBg(x, y)) bgCount++; }
          if (bgCount < (bottom - top) * 0.95) { left = x; break; }
        }
        for (let x = w - 1; x >= left; x--) {
          let bgCount = 0;
          for (let y = top; y <= bottom; y++) { if (isBg(x, y)) bgCount++; }
          if (bgCount < (bottom - top) * 0.95) { right = x; break; }
        }
      } catch (e) { console.warn('自动去边失败', e); }
    }

    // 叠加手动输入的像素裁剪
    top = Math.min(top + cTop, h - 1);
    bottom = Math.max(bottom - cBottom, top + 1);
    left = Math.min(left + cLeft, w - 1);
    right = Math.max(right - cRight, left + 1);

    const cw = right - left + 1;
    const ch = bottom - top + 1;

    const out = document.createElement('canvas');
    out.width = cw;
    out.height = ch;
    out.getContext('2d').drawImage(img, left, top, cw, ch, 0, 0, cw, ch);
    return out;
  }

  async function preprocessAll() {
    const isAuto = autoTrimCb.checked;
    const cT = Number(cropTop.value);
    const cB = Number(cropBottom.value);
    const cL = Number(cropLeft.value);
    const cR = Number(cropRight.value);
    const cacheKey = `${isAuto}-${cT}-${cB}-${cL}-${cR}`;

    for (const item of items) {
      if (!item.img) continue;
      if (!item.cache || item.cache.key !== cacheKey) {
        item.cache = { key: cacheKey, canvas: processImage(item.img, isAuto, cT, cB, cL, cR) };
      }
      item.effectiveCanvas = item.cache.canvas;
    }
  }

  function getSource(item) { return item.effectiveCanvas || item.img; }

  // 渲染主画布
  async function render() {
    const token = ++renderToken;

    if (items.length === 0) {
      previewCanvas.style.display = 'none';
      emptyState.style.display = 'block';
      downloadBtn.disabled = true;
      return;
    }

    await preprocessAll();
    if (token !== renderToken) return; 

    const layout = layoutSelect.value;
    const gap = Number(gapRange.value);
    const bgColor = bgColorInput.value;
    const gridCols = Number(gridColsRange.value);

    const boxes = computeLayout(layout, gap, gridCols);
    if (!boxes || boxes.length === 0) return;

    const canvasW = Math.ceil(Math.max(...boxes.map(b => b.x + b.w)));
    const canvasH = Math.ceil(Math.max(...boxes.map(b => b.y + b.h)));

    const MAX_DIM = 10000; // 限制最大分辨率防崩溃
    let scale = 1;
    if (canvasW > MAX_DIM || canvasH > MAX_DIM) {
      scale = Math.min(MAX_DIM / canvasW, MAX_DIM / canvasH);
    }

    previewCanvas.width = Math.ceil(canvasW * scale);
    previewCanvas.height = Math.ceil(canvasH * scale);
    previewCanvas.style.display = 'block';
    emptyState.style.display = 'none';

    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, previewCanvas.width, previewCanvas.height);
    ctx.scale(scale, scale);

    if (bgColor !== 'transparent') {
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, canvasW, canvasH);
    }

    for (let i = 0; i < items.length && i < boxes.length; i++) {
      const box = boxes[i];
      const src = getSource(items[i]);
      if (src && src.width && src.height) {
        ctx.drawImage(src, 0, 0, src.width, src.height, box.x, box.y, box.w, box.h);
      }
    }

    downloadBtn.disabled = false;
  }

  // 计算布局坐标
  function computeLayout(layout, gap, gridCols) {
    const sources = items.map(getSource).filter(s => s && s.width && s.height);
    if (sources.length === 0) return [];

    if (layout === 'horizontal') {
      let x = 0;
      const maxH = Math.max(...sources.map(c => c.height));
      return sources.map(src => {
        const box = { x, y: (maxH - src.height) / 2, w: src.width, h: src.height };
        x += src.width + gap;
        return box;
      });
    }

    if (layout === 'vertical') {
      let y = 0;
      const maxW = Math.max(...sources.map(c => c.width));
      return sources.map(src => {
        const box = { x: (maxW - src.width) / 2, y, w: src.width, h: src.height };
        y += src.height + gap;
        return box;
      });
    }

    const cols = Math.max(1, gridCols);
    const rows = Math.ceil(sources.length / cols);
    const colWidths = new Array(cols).fill(0);
    const rowHeights = new Array(rows).fill(0);

    sources.forEach((src, i) => {
      const c = i % cols;
      const r = Math.floor(i / cols);
      colWidths[c] = Math.max(colWidths[c], src.width);
      rowHeights[r] = Math.max(rowHeights[r], src.height);
    });

    const boxes = [];
    let y = 0;
    for (let r = 0; r < rows; r++) {
      let x = 0;
      for (let c = 0; c < cols; c++) {
        const idx = r * cols + c;
        if (idx >= sources.length) { x += colWidths[c] + gap; continue; }
        const src = sources[idx];
        const cellW = colWidths[c];
        const cellH = rowHeights[r];
        const scale = Math.min(cellW / src.width, cellH / src.height);
        const w = src.width * scale;
        const h = src.height * scale;
        boxes.push({ x: x + (cellW - w) / 2, y: y + (cellH - h) / 2, w, h });
        x += cellW + gap;
      }
      y += rowHeights[r] + gap;
    }
    return boxes;
  }

  // 文件添加与列表渲染
  async function addFiles(files) {
    const imageFiles = Array.from(files).filter(f => f.type.startsWith('image/'));
    if (imageFiles.length === 0) return;

    for (const file of imageFiles) {
      try {
        const img = await loadImage(file);
        const thumbUrl = createThumbnail(img);
        items.push({ id: uid(), file, img, thumbUrl, effectiveCanvas: null, cache: null });
      } catch (e) { toast('无法加载：' + file.name); }
    }
    renderFileList();
    render();
  }

  function renderFileList() {
    if (items.length === 0) {
      fileListEl.innerHTML = '<div style="font-size:12px;color:#86868b;text-align:center;padding:12px 0;">尚未添加图片</div>';
      return;
    }
    fileListEl.innerHTML = '';
    items.forEach((item, idx) => {
      const div = document.createElement('div');
      div.className = 'file-item';
      div.draggable = true;
      div.dataset.id = item.id;
      div.innerHTML = `
        <span class="idx">${idx + 1}</span>
        <img class="thumb" src="${item.thumbUrl}" alt="预览">
        <span class="name" title="${item.file.name}">${item.file.name}</span>
        <button class="remove" data-id="${item.id}" title="移除">×</button>
      `;

      div.addEventListener('dragstart', (e) => {
        dragSrcId = item.id; div.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move';
      });
      div.addEventListener('dragend', () => {
        div.classList.remove('dragging'); dragSrcId = null;
      });
      div.addEventListener('dragover', (e) => e.preventDefault());
      div.addEventListener('drop', (e) => {
        e.preventDefault();
        if (!dragSrcId || dragSrcId === item.id) return;
        const from = items.findIndex(x => x.id === dragSrcId);
        const to = items.findIndex(x => x.id === item.id);
        if (from < 0 || to < 0) return;
        const [moved] = items.splice(from, 1);
        items.splice(to, 0, moved);
        renderFileList(); render();
      });

      fileListEl.appendChild(div);
    });

    fileListEl.querySelectorAll('.remove').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        items = items.filter(x => x.id !== btn.dataset.id);
        renderFileList(); render();
      });
    });
  }

  function download() {
    if (items.length === 0) return;
    previewCanvas.toBlob((blob) => {
      if (!blob) { toast('导出失败'); return; }
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `merged-${Date.now()}.png`; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      toast('已开始下载');
    }, 'image/png');
  }

  // ============ 事件绑定 ============
  uploadBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => { if (fileInput.files.length) addFiles(fileInput.files); fileInput.value = ''; });
  document.body.addEventListener('dragover', (e) => e.preventDefault());
  document.body.addEventListener('drop', (e) => { e.preventDefault(); if (e.dataTransfer.files.length) addFiles(e.dataTransfer.files); });

  layoutSelect.addEventListener('change', () => {
    gridColsGroup.style.display = layoutSelect.value === 'grid' ? '' : 'none';
    render();
  });
  
  // 绑定所有输入框
  bindInputs(gapRange, gapInput, render);
  bindInputs(gridColsRange, gridColsInput, render);
  bindInputs(cropTop, cropTopInput, render);
  bindInputs(cropBottom, cropBottomInput, render);
  bindInputs(cropLeft, cropLeftInput, render);
  bindInputs(cropRight, cropRightInput, render);
  
  bgColorInput.addEventListener('input', render);
  autoTrimCb.addEventListener('change', render);
  downloadBtn.addEventListener('click', download);

  render();
})();
</script>
</body>
</html>
